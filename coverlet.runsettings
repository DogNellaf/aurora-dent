<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Only our own code counts; generated Razor views are not interesting. -->
          <Include>[DentalClinic]*</Include>
          <Exclude>[DentalClinic]AspNetCoreGeneratedDocument.*,[DentalClinic]DentalClinic.Program</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
