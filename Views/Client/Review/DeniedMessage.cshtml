@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = T["Мой отзыв"];
    ViewData["Cabinet"] = "client";
    ViewData["Tab"] = "review";
}
<div class="cab-head"><div><h1>@T["Мой отзыв"]</h1></div></div>
<div class="card empty">
    <svg class="ic"><use href="#i-message"/></svg>
    <h3>@T["Отзыв можно оставить после первого визита"]</h3>
    <p>@T["Как только вы посетите клинику, здесь появится форма отзыва."]</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Schedule">@T["Записаться на приём"]</a>
</div>
