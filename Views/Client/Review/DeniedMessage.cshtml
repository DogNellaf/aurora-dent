@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = "Мой отзыв";
    ViewData["Cabinet"] = "client";
    ViewData["Tab"] = "review";
}
<div class="cab-head"><div><h1>Мой отзыв</h1></div></div>
<div class="card empty">
    <svg class="ic"><use href="#i-message"/></svg>
    <h3>Отзыв можно оставить после первого визита</h3>
    <p>Как только вы посетите клинику, здесь появится форма отзыва.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Schedule">Записаться на приём</a>
</div>
