@model List<AppointmentRow>
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = "Приёмы";
    ViewData["Cabinet"] = "admin";
    ViewData["Tab"] = "appointments";
    var filter = ViewBag.Filter as string ?? "upcoming";
}
<div class="cab-head">
    <div><h1>Приёмы</h1><p>Расписание всех врачей</p></div>
    <a class="btn btn-primary" asp-action="AppointmentCreate"><svg class="ic"><use href="#i-plus"/></svg> Новое окно</a>
</div>
<div class="tabs">
    <a class="@(filter == "upcoming" ? "active" : "")" asp-action="Index">Записи впереди</a>
    <a class="@(filter == "free" ? "active" : "")" asp-action="Index" asp-route-filter="free">Свободные окна</a>
    <a class="@(filter == "past" ? "active" : "")" asp-action="Index" asp-route-filter="past">Прошедшие</a>
</div>
@if (Model.Count == 0)
{
    <div class="card empty"><svg class="ic"><use href="#i-calendar"/></svg><h3>Ничего не найдено</h3></div>
}
else
{
    <div class="card table-wrap">
        <table class="table">
            <thead><tr><th>Дата и время</th><th>Врач</th><th>Пациент</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                var a = r.Appointment;
                <tr>
                    <td><b>@Fmt.DateTimeShort(a.StartAt)</b><br><small class="muted">#@a.Id · @Fmt.Minutes(a.Duration)</small></td>
                    <td>@a.Staff?.DisplayName</td>
                    <td>@if (a.IsBooked) { @r.ClientName } else { <span class="badge ok">Свободно</span> }</td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-ghost btn-sm" asp-action="Appointment" asp-route-appointmentId="@a.Id"><svg class="ic"><use href="#i-edit"/></svg> Изменить</a>
                            <form asp-action="AppointmentDelete" asp-route-appointmentId="@a.Id" method="post" data-confirm="Удалить приём #@a.Id?">
                                <button class="btn btn-danger btn-sm" type="submit" aria-label="Удалить"><svg class="ic"><use href="#i-trash"/></svg></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
