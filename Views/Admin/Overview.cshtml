@model AdminOverview
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = T["Панель администратора"];
    ViewData["Cabinet"] = "admin";
    ViewData["Tab"] = "overview";
}
<div class="cab-head">
    <div><h1>@T["Обзор клиники"]</h1><p>@T["Что происходит прямо сейчас"]</p></div>
    <a class="btn btn-primary" asp-action="AppointmentCreate"><svg class="ic"><use href="#i-plus"/></svg> @T["Добавить окно в расписание"]</a>
</div>
<div class="stat-cards">
    <div class="card stat-card"><span class="ico"><svg class="ic"><use href="#i-calendar"/></svg></span><div><b>@Model.Upcoming</b><span>@T["записей впереди"]</span></div></div>
    <div class="card stat-card"><span class="ico g"><svg class="ic"><use href="#i-clock"/></svg></span><div><b>@Model.FreeSlots</b><span>@T["свободных окон"]</span></div></div>
    <div class="card stat-card"><span class="ico c"><svg class="ic"><use href="#i-users"/></svg></span><div><b>@Model.Clients</b><span>@T["пациентов"]</span></div></div>
    <div class="card stat-card"><span class="ico"><svg class="ic"><use href="#i-award"/></svg></span><div><b>@Model.Doctors</b><span>@T["врачей"]</span></div></div>
    <a class="card stat-card" asp-action="Reviews" style="color:inherit"><span class="ico c"><svg class="ic"><use href="#i-message"/></svg></span><div><b>@Model.PendingReviews</b><span>@T["отзывов ждут проверки"]</span></div></a>
</div>
<div class="group-title">@T["Ближайшие записи"]</div>
@if (Model.NextAppointments.Count == 0)
{
    <div class="card empty"><h3>@T["Записей пока нет"]</h3></div>
}
else
{
    <div class="card table-wrap">
        <table class="table">
            <thead><tr><th>@T["Когда"]</th><th>@T["Пациент"]</th><th>@T["Врач"]</th><th>@T["Услуга"]</th></tr></thead>
            <tbody>
            @foreach (var r in Model.NextAppointments)
            {
                <tr>
                    <td><b>@Fmt.DateTimeShort(r.Appointment.StartAt)</b></td>
                    <td>@r.ClientName</td>
                    <td>@r.Appointment.Staff?.DisplayName</td>
                    <td>@T.ServiceList(r.Appointment.Services, "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
