@using DentalClinic.Models.DTO
@model ProfileEditModel
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = "Редактирование профиля";
    ViewData["Cabinet"] = "admin";
    ViewData["Tab"] = "profiles";
}
<div class="cab-head"><div><div class="crumbs"><a asp-action="Profiles">Профили</a> / <span>Редактирование</span></div><h1>@Model.FullName</h1></div>
    @if (Model.IsBanned) { <span class="badge danger">Заблокирован</span> }</div>
<div class="card card-pad" style="max-width:720px">
    <form asp-action="ProfileUpdate" asp-route-profileId="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field"><label asp-for="FullName">Имя и фамилия</label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div>
        <div class="row">
            <div class="field"><label asp-for="Email">Email (он же логин)</label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
            <div class="field"><label asp-for="Phone">Телефон</label><input asp-for="Phone" type="tel" /><span asp-validation-for="Phone"></span></div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Сохранить</button>
            <a class="btn btn-ghost" asp-action="Profiles">Отмена</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
