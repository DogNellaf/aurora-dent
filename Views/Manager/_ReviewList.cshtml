@model List<ReviewCard>
@{ var pending = (bool)ViewData["Pending"]!; }
@if (Model.Count == 0)
{
    <div class="card empty"><svg class="ic"><use href="#i-message"/></svg><h3>@(pending ? "Новых отзывов нет" : "Опубликованных отзывов нет")</h3><p>@(pending ? "Все отзывы проверены — отличная работа." : "Опубликуйте отзывы из очереди модерации.")</p></div>
}
else
{
    <div class="list">
        @foreach (var r in Model)
        {
            <div class="card rev-item">
                <div>
                    <div class="rev-head"><span class="avatar">@Fmt.Initials(r.Author)</span><b>@r.Author</b><partial name="_Stars" model="r.Rating" /><span class="muted">@Fmt.Date(r.CreatedAt)</span></div>
                    <p>@r.Text</p>
                </div>
                <div class="appt-actions">
                    @if (pending)
                    {
                        <form asp-action="Show" asp-route-reviewId="@r.Id" method="post"><button class="btn btn-primary btn-sm" type="submit"><svg class="ic"><use href="#i-check"/></svg> Опубликовать</button></form>
                    }
                    else
                    {
                        <form asp-action="Hide" asp-route-reviewId="@r.Id" method="post"><button class="btn btn-ghost btn-sm" type="submit">Скрыть</button></form>
                    }
                </div>
            </div>
        }
    </div>
}
