@model List<Appointment>
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = T["Карта пациента"];
    ViewData["Cabinet"] = "doctor";
    ViewData["Tab"] = "";
    var client = (Profile)ViewBag.Client;
}
<div class="cab-head">
    <div>
        <div class="crumbs"><a asp-action="Index">@T["Кабинет"]</a> / <span>@T["Карта пациента"]</span></div>
        <h1>@T[client.DisplayName]</h1>
        <p>@client.PhoneNumber · @client.Email</p>
    </div>
    <span class="badge">@T["визитов: {0}", Model.Count]</span>
</div>
@if (Model.Count == 0)
{
    <div class="card empty"><h3>@T["У пациента пока нет приёмов"]</h3></div>
}
else
{
    <div class="list">
        @foreach (var a in Model)
        {
            <div class="card appt @(a.IsPastAt(Clock.Now) ? "past" : "")">
                <partial name="_DateBox" model="a.StartAt" />
                <div>
                    <h4>@T.ServiceList(a.Services)</h4>
                    <div class="meta">
                        <span><svg class="ic"><use href="#i-user"/></svg> @T[a.Staff?.DisplayName ?? ""]</span>
                        <span><svg class="ic"><use href="#i-clock"/></svg> @Fmt.Date(a.StartAt), @Fmt.Time(a.StartAt), @Fmt.Minutes(a.Duration)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(a.Recommendation)) { <p class="soft" style="margin:10px 0 0;font-size:.92rem"><b>@T["Рекомендации:"]</b> @a.Recommendation</p> }
                </div>
                <div></div>
            </div>
        }
    </div>
}
