@model List<Appointment>
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = "Карта пациента";
    ViewData["Cabinet"] = "doctor";
    ViewData["Tab"] = "";
    var client = (Profile)ViewBag.Client;
}
<div class="cab-head">
    <div>
        <div class="crumbs"><a asp-action="Index">Кабинет</a> / <span>Карта пациента</span></div>
        <h1>@client.DisplayName</h1>
        <p>@client.PhoneNumber · @client.Email</p>
    </div>
    <span class="badge">@Model.Count визитов</span>
</div>
@if (Model.Count == 0)
{
    <div class="card empty"><h3>У пациента пока нет приёмов</h3></div>
}
else
{
    <div class="list">
        @foreach (var a in Model)
        {
            <div class="card appt @(a.IsPast ? "past" : "")">
                <partial name="_DateBox" model="a.StartAt" />
                <div>
                    <h4>@(a.Services.Count > 0 ? string.Join(", ", a.Services.Select(s => s.Title)) : "Приём врача")</h4>
                    <div class="meta">
                        <span><svg class="ic"><use href="#i-user"/></svg> @(a.Staff?.DisplayName)</span>
                        <span><svg class="ic"><use href="#i-clock"/></svg> @Fmt.Date(a.StartAt), @Fmt.Time(a.StartAt), @Fmt.Minutes(a.Duration)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(a.Recommendation)) { <p class="soft" style="margin:10px 0 0;font-size:.92rem"><b>Рекомендации:</b> @a.Recommendation</p> }
                </div>
                <div></div>
            </div>
        }
    </div>
}
