@model List<AppointmentRow>
@{
    Layout = "_CabinetLayout";
    var filter = ViewBag.Filter as string ?? "upcoming";
    ViewData["Title"] = filter == "past" ? "История приёмов" : "Предстоящие приёмы";
    ViewData["Cabinet"] = "doctor";
    ViewData["Tab"] = filter;
}
<div class="cab-head"><div><h1>@ViewData["Title"]</h1><p>@Model.Count записей</p></div></div>
@if (Model.Count == 0)
{
    <div class="card empty"><svg class="ic"><use href="#i-calendar"/></svg><h3>Приёмов не найдено</h3></div>
}
else
{
    <div class="list">
        @foreach (var r in Model)
        {
            var a = r.Appointment;
            <div class="card appt @(a.IsPast ? "past" : "")">
                <partial name="_DateBox" model="a.StartAt" />
                <div>
                    <h4>@r.ClientName</h4>
                    <div class="meta">
                        <span><svg class="ic"><use href="#i-clock"/></svg> @Fmt.Weekday(a.StartAt), @Fmt.Time(a.StartAt)–@Fmt.Time(a.EndAt)</span>
                        <span>@(a.Services.Count > 0 ? string.Join(", ", a.Services.Select(s => s.Title)) : "Приём врача")</span>
                        @if (!string.IsNullOrEmpty(a.Recommendation)) { <span class="badge ok">Рекомендации оставлены</span> }
                    </div>
                </div>
                <div class="appt-actions"><a class="btn btn-ghost btn-sm" asp-action="Appointment" asp-route-appointmentId="@a.Id">Открыть</a></div>
            </div>
        }
    </div>
}
