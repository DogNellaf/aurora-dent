@{
    ViewData["Title"] = T["Контакты"];
}
<div class="wrap">
    <div class="page-head">
        <div class="crumbs"><a asp-controller="Home" asp-action="Index">@T["Главная"]</a> / <span>@T["Контакты"]</span></div>
        <h1>@T["Контакты"]</h1>
        <p class="lead">@T["Мы в центре города, в пяти минутах от метро. Работаем каждый день без выходных."]</p>
    </div>
    <div class="split" style="align-items:stretch;padding-bottom:70px">
        <div class="grid" style="align-content:start">
            <div class="card contact-card reveal"><span class="ico"><svg class="ic"><use href="#i-pin"/></svg></span><div><h4>@T["Адрес"]</h4><p>@T["г. Москва, ул. Примерная, д. 1"]</p></div></div>
            <div class="card contact-card reveal"><span class="ico"><svg class="ic"><use href="#i-phone"/></svg></span><div><h4>@T["Телефон"]</h4><p><a href="tel:+74950000000">+7 (495) 000-00-00</a></p></div></div>
            <div class="card contact-card reveal"><span class="ico"><svg class="ic"><use href="#i-clock"/></svg></span><div><h4>@T["Режим работы"]</h4><p>@T["Ежедневно с 8:00 до 23:00"]</p></div></div>
            <div class="card contact-card reveal"><span class="ico"><svg class="ic"><use href="#i-mail"/></svg></span><div><h4>@T["Электронная почта"]</h4><p><a href="mailto:info@clinic.example">info@clinic.example</a></p></div></div>
            <div class="note reveal">@T["Оплата наличными и картой, лечение в рассрочку. Принимаем пациентов с 4 лет."]
                <div style="margin-top:14px"><a class="btn btn-accent" asp-controller="Home" asp-action="Schedule">@T["Записаться онлайн"]</a></div></div>
        </div>
        <div class="map reveal">
            <iframe title="@T["Карта: центр Москвы"]" loading="lazy" referrerpolicy="no-referrer"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=37.5900%2C55.7380%2C37.6500%2C55.7650&amp;layer=mapnik&amp;marker=55.7517%2C37.6178"></iframe>
        </div>
    </div>
</div>
