@model List<Staff>
@{
    ViewData["Title"] = T["Наши врачи"];
}
<div class="wrap">
    <div class="page-head">
        <div class="crumbs"><a asp-controller="Home" asp-action="Index">@T["Главная"]</a> / <span>@T["Врачи"]</span></div>
        <h1>@T["Наши врачи"]</h1>
        <p class="lead">@T["Опытные специалисты, которые постоянно учатся и объясняют каждый этап лечения."]</p>
    </div>
    <div class="grid grid-3" style="padding-bottom:60px">
        @foreach (var d in Model)
        {
            <partial name="_DoctorCard" model="d" />
        }
    </div>
</div>
