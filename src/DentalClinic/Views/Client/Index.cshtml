@model List<Appointment>
@{
    Layout = "_CabinetLayout";
    ViewData["Title"] = T["Мои записи"];
    ViewData["Cabinet"] = "client";
    ViewData["Tab"] = "records";
    var profile = (Profile)ViewBag.Profile;
    var now = Clock.Now;
    var upcoming = Model.Where(a => a.EndAt >= now).OrderBy(a => a.StartAt).ToList();
    var past = Model.Where(a => a.EndAt < now).ToList();
}
<div class="cab-head">
    <div><h1>@T["Здравствуйте, {0}!", T[profile.DisplayName].Value.Split(' ')[0]]</h1><p>@T["Ваши записи и история лечения"]</p></div>
    <a class="btn btn-accent" asp-controller="Home" asp-action="Schedule"><svg class="ic"><use href="#i-plus"/></svg> @T["Записаться на приём"]</a>
</div>

<div class="group-title">@T["Предстоящие"]</div>
@if (upcoming.Count == 0)
{
    <div class="card empty"><svg class="ic"><use href="#i-calendar"/></svg><h3>@T["Нет предстоящих записей"]</h3><p>@T["Выберите врача и удобное время — это займёт минуту."]</p><a class="btn btn-primary" asp-controller="Home" asp-action="Schedule">@T["Записаться"]</a></div>
}
else
{
    <div class="list">
        @foreach (var a in upcoming)
        {
            <div class="card appt">
                <partial name="_DateBox" model="a.StartAt" />
                <div>
                    <h4>@T.ServiceList(a.Services)</h4>
                    <div class="meta">
                        <span><svg class="ic"><use href="#i-clock"/></svg> @Fmt.Weekday(a.StartAt), @Fmt.Time(a.StartAt)–@Fmt.Time(a.EndAt)</span>
                        <span><svg class="ic"><use href="#i-user"/></svg> @T[a.Staff?.DisplayName ?? ""]</span>
                    </div>
                </div>
                <div class="appt-actions">
                    <a class="btn btn-ghost btn-sm" asp-action="Appointment" asp-route-appointmentId="@a.Id">@T["Подробнее"]</a>
                    <form asp-action="Cancel" asp-route-appointmentId="@a.Id" method="post" data-confirm="@T["Отменить запись на {0}?", Fmt.DateTimeShort(a.StartAt)]">
                        <button class="btn btn-danger btn-sm" type="submit">@T["Отменить"]</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@if (past.Count > 0)
{
    <div class="group-title">@T["История"]</div>
    <div class="list">
        @foreach (var a in past)
        {
            <div class="card appt past">
                <partial name="_DateBox" model="a.StartAt" />
                <div>
                    <h4>@T.ServiceList(a.Services)</h4>
                    <div class="meta">
                        <span><svg class="ic"><use href="#i-clock"/></svg> @Fmt.Date(a.StartAt), @Fmt.Time(a.StartAt)</span>
                        <span><svg class="ic"><use href="#i-user"/></svg> @T[a.Staff?.DisplayName ?? ""]</span>
                        @if (!string.IsNullOrEmpty(a.Recommendation)) { <span class="badge ok"><svg class="ic"><use href="#i-clipboard"/></svg> @T["Есть рекомендации"]</span> }
                    </div>
                </div>
                <div class="appt-actions"><a class="btn btn-ghost btn-sm" asp-action="Appointment" asp-route-appointmentId="@a.Id">@T["Подробнее"]</a></div>
            </div>
        }
    </div>
}
