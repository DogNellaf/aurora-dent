@model Staff
<article class="card doc reveal">
    <div class="doc-photo">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@T[Model.DisplayName]" loading="lazy">
        }
        else
        {
            <div class="doc-fallback">@Fmt.Initials(T[Model.DisplayName].Value)</div>
        }
        @if (Model.ExperienceYears > 0)
        {
            <span class="badge"><svg class="ic"><use href="#i-award"/></svg> @T["Стаж {0}", Fmt.Years(Model.ExperienceYears)]</span>
        }
    </div>
    <div class="doc-body">
        <h3>@T[Model.DisplayName]</h3>
        <span class="role">@T[Model.Specialty]</span>
        <p>@T[Model.Bio]</p>
        <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Schedule" asp-route-staffId="@Model.Id">@T["Записаться"] <svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
</article>
