@model ReviewCard
<article class="card review reveal">
    <partial name="_Stars" model="Model.Rating" />
    <p>@T[Model.Text]</p>
    <footer>
        <span class="avatar">@Fmt.Initials(Model.Author)</span>
        <div><b>@T[Model.Author]</b><small>@T["Пациент клиники"] · @Fmt.Date(Model.CreatedAt)</small></div>
    </footer>
</article>
